# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.packages
build/

# Ignore ZXScanner folders
zxscanner/

# Ignore ZXing-CPP unneeded files 
src/zxing/*
!src/zxing/CMakeLists.txt
!src/zxing/zxing.cmake
!src/zxing/core/

# core/src/libzint is a set of one-line forwarders into the nested `zint`
# submodule, so its backend has to ship as well for the CMake platforms to
# build. Its tests and tools are 13 MB of fixtures we never compile.
!src/zxing/zint/
src/zxing/zint/*
!src/zxing/zint/LICENSE
!src/zxing/zint/backend/
src/zxing/zint/backend/tests/
src/zxing/zint/backend/tools/
