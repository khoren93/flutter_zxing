# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.packages
build/

# Ignore ZXScanner folders
zxscanner/

# Ignore ZXing-CPP unneeded files 
third_party/zxing-cpp/*
!third_party/zxing-cpp/LICENSE
!third_party/zxing-cpp/core/

# core/src/libzint is a set of one-line forwarders into the nested `zint`
# submodule, so its backend has to ship as well for the build hook. Its tests
# and tools are 13 MB of fixtures we never compile.
!third_party/zxing-cpp/zint/
third_party/zxing-cpp/zint/*
!third_party/zxing-cpp/zint/LICENSE
!third_party/zxing-cpp/zint/backend/
third_party/zxing-cpp/zint/backend/tests/
third_party/zxing-cpp/zint/backend/tools/

# Development only: engine tools (WebAssembly build, source list, fixtures,
# headless browser tests) and the engine's test corpus with its runners. The
# build hook needs none of it: it compiles hook/sources.g.dart's list with
# native/generated/Version.h, and the WebAssembly modules ship prebuilt in
# assets/web/.
tool/
native/CMakeLists.txt
example/assets/fixtures/
example/lib/corpus/
example/lib/corpus_web.dart
example/integration_test/corpus_test.dart

# Local 4.0 roadmap and progress notes. .gitignore is not read once a
# .pubignore exists, so the rule has to be repeated here.
PROGRESS.md
API_REVIEW.md
